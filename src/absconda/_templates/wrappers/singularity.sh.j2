#!/bin/bash
# Auto-generated by absconda wrap
# Image: {{ image_ref }}
# Command: {{ command }}
set -euo pipefail

module load singularity 

{% if image_cache %}
SIF_CACHE="{{ image_cache }}"
{% else %}
SIF_CACHE="${HOME}/.local/absconda/sif-cache"
{% endif %}
SIF_FILE="${SIF_CACHE}/{{ sif_filename }}"

# Build mount arguments (skip paths that don't exist)
MOUNTS=()
NO_HOME=""
{% for mount in mounts %}
_mount="{{ mount }}"
if [[ -d "$_mount" ]]; then
    MOUNTS+=("-B" "$_mount")
fi
{% endfor %}
{% for mount in mounts %}
{% if mount == '$HOME' %}
# Suppress duplicate-mount warning: Singularity auto-mounts $HOME by default
NO_HOME="--no-home"
{% endif %}
{% endfor %}

{% if use_pbs_env %}
# PBS shims (provides PBS_MOUNTS, PBS_PATH; includes /lib64:/host-lib64:ro)
source {{ pbs_container_env }}
MOUNTS+=("${PBS_MOUNTS[@]}")
{% endif %}

{% if shim_bind_mounts %}
# Additional shim bind mounts
{% for bind_spec in shim_bind_mounts %}
MOUNTS+=("-B" "{{ bind_spec }}")
{% endfor %}
{% endif %}

# Bind-mount host CA certificates so TLS verification works inside the container
_CA_BUNDLE="/etc/pki/tls/certs/ca-bundle.crt"
if [[ -f "$_CA_BUNDLE" ]]; then
    MOUNTS+=("-B" "$_CA_BUNDLE:$_CA_BUNDLE:ro")
    export SINGULARITYENV_SSL_CERT_FILE="$_CA_BUNDLE"
fi

{% if singularity_shims %}
# Singularity does not pass host SINGULARITY_* / APPTAINER_* variables into
# the container, so a singularity run inside it (through the shims) would not
# see the host's cache and temp dirs and would fall back to $HOME. Forward the
# ones that are set as SINGULARITYENV_* and bind them so they are writable.
# Only absolute paths usable in a -B spec (no ':' or ',') that exist or can be
# created are forwarded; anything else is left alone, as before.
_BOUND=()
for _var in SINGULARITY_CACHEDIR SINGULARITY_TMPDIR APPTAINER_CACHEDIR APPTAINER_TMPDIR; do
    _envvar="SINGULARITYENV_${_var}"
    _val="${!_envvar:-${!_var:-}}"
    [[ "$_val" == /* && "$_val" != *[:,]* ]] || continue
    mkdir -p -- "$_val" 2>/dev/null || true
    [[ -d "$_val" ]] || continue
    export "${_envvar}=${_val}"
    if [[ " ${_BOUND[*]:-} " != *" $_val "* ]]; then
        MOUNTS+=("-B" "$_val")
        _BOUND+=("$_val")
    fi
done

{% endif %}
{% if gpu %}
# GPU support
GPU_FLAG="--nv"
{% else %}
GPU_FLAG=""
{% endif %}

{% if env_dir %}
# Set PATH to include conda environment
{% set path_parts = [env_dir ~ "/bin", "/opt/conda/bin"] %}
{% if use_pbs_env %}
{% set _ = path_parts.append("${PBS_PATH}") %}
{% endif %}
{% for d in shim_path_dirs %}
{% set _ = path_parts.append(d) %}
{% endfor %}
{% set _ = path_parts.extend(["/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"]) %}
export SINGULARITYENV_PATH="{{ path_parts | join(':') }}"
export SINGULARITYENV_CONDA_PREFIX="{{ env_dir }}"
{% else %}
{% set path_parts = ["/opt/conda/bin"] %}
{% if use_pbs_env %}
{% set _ = path_parts.append("${PBS_PATH}") %}
{% endif %}
{% for d in shim_path_dirs %}
{% set _ = path_parts.append(d) %}
{% endfor %}
{% set _ = path_parts.extend(["/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"]) %}
export SINGULARITYENV_PATH="{{ path_parts | join(':') }}"
{% endif %}

# Execute command in container
exec singularity exec \
    $NO_HOME \
    $GPU_FLAG \
    ${MOUNTS[@]+"${MOUNTS[@]}"} \
    "$SIF_FILE" \
    {{ command }} "$@"
