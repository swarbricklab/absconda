#!/bin/bash
# Auto-generated by absconda wrap
# Image: {{ image_ref }}
# Command: {{ command }}
set -euo pipefail

module load singularity 

{% if image_cache %}
SIF_CACHE="{{ image_cache }}"
{% else %}
SIF_CACHE="${HOME}/.local/absconda/sif-cache"
{% endif %}
SIF_FILE="${SIF_CACHE}/{{ sif_filename }}"

# Build mount arguments (skip paths that don't exist)
MOUNTS=()
NO_HOME=""
{% for mount in mounts %}
_mount="{{ mount }}"
if [[ -d "$_mount" ]]; then
    MOUNTS+=("-B" "$_mount")
fi
{% endfor %}
{% for mount in mounts %}
{% if mount == '$HOME' %}
# Suppress duplicate-mount warning: Singularity auto-mounts $HOME by default
NO_HOME="--no-home"
{% endif %}
{% endfor %}

{% if gpu %}
# GPU support
GPU_FLAG="--nv"
{% else %}
GPU_FLAG=""
{% endif %}

{% if env_dir %}
# Set PATH to include conda environment
export SINGULARITYENV_PATH="{{ env_dir }}/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export SINGULARITYENV_CONDA_PREFIX="{{ env_dir }}"
{% endif %}

# Execute command in container
exec singularity exec \
    $NO_HOME \
    $GPU_FLAG \
    "${MOUNTS[@]}" \
    "$SIF_FILE" \
    {{ command }} "$@"
