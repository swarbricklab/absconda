FROM {{ base_image }}
{% if labels %}
{% for label in labels %}
LABEL {{ label }}
{% endfor %}
{% endif %}

# Install micromamba into the chosen base image so the conda environment is built
# directly on top of it. System libraries (e.g. CUDA/cuDNN from an nvidia/cuda
# base) come from the base image rather than from the solver, which avoids hard
# CUDA/PyTorch constraint solves and lets build-time pip compilation see the
# base's toolkit. Assumes a glibc base with apt-get (Debian/Ubuntu, incl. the
# nvidia/cuda images); for other bases supply a custom --template.
RUN if command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        apt-get install -y --no-install-recommends bzip2 ca-certificates curl && \
        apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi && \
    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
        | tar -xj -C /usr/local bin/micromamba
ENV MAMBA_ROOT_PREFIX=/opt/conda

COPY <<'ABSCONDA_ENV' /tmp/env.yaml
{{ conda_env_yaml }}
ABSCONDA_ENV
{% if has_pip %}
COPY <<'ABSCONDA_PIP' /tmp/requirements.txt
{{ pip_requirements }}
ABSCONDA_PIP
{% endif %}

# Install conda packages first, then pip packages constrained to the versions
# conda resolved (pip otherwise ignores conda's pins and may upgrade past them).
# pip fails on a conflict instead of silently clobbering a pinned package.
RUN micromamba create -y -n {{ env_name }} {{ channel_flags }} -f /tmp/env.yaml && \
{% if has_pip %}
    micromamba run -n {{ env_name }} python -m pip list --format=freeze > /tmp/conda.constraints.txt && \
    micromamba run -n {{ env_name }} python -m pip install --no-cache-dir \
        --constraint /tmp/conda.constraints.txt --requirement /tmp/requirements.txt && \
    micromamba run -n {{ env_name }} python -m pip check && \
{% endif %}
    micromamba clean -afy && \
    rm -f /tmp/env.yaml{% if has_pip %} /tmp/requirements.txt /tmp/conda.constraints.txt{% endif %}
