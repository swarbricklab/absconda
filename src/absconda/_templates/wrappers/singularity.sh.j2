#!/bin/bash
# Auto-generated by absconda wrap
# Image: {{ image_ref }}
# Command: {{ command }}
set -euo pipefail

module load singularity 

{% if image_cache %}
SIF_CACHE="{{ image_cache }}"
{% else %}
SIF_CACHE="${HOME}/.local/absconda/sif-cache"
{% endif %}
SIF_FILE="${SIF_CACHE}/{{ sif_filename }}"

# Build mount arguments (skip paths that don't exist)
MOUNTS=()
NO_HOME=""
{% for mount in mounts %}
_mount="{{ mount }}"
if [[ -d "$_mount" ]]; then
    MOUNTS+=("-B" "$_mount")
fi
{% endfor %}
{% for mount in mounts %}
{% if mount == '$HOME' %}
# Suppress duplicate-mount warning: Singularity auto-mounts $HOME by default
NO_HOME="--no-home"
{% endif %}
{% endfor %}

{% if use_pbs_env %}
# PBS shims (provides PBS_MOUNTS, PBS_PATH; includes /lib64:/host-lib64:ro)
source {{ pbs_container_env }}
MOUNTS+=("${PBS_MOUNTS[@]}")
{% endif %}

{% if shim_bind_mounts %}
# Additional shim bind mounts
{% for bind_spec in shim_bind_mounts %}
MOUNTS+=("-B" "{{ bind_spec }}")
{% endfor %}
{% endif %}

ENV_NAMES=(
{% for env_name in env_passthrough %}
    "{{ env_name }}"
{% endfor %}
)

for env_name in "${ENV_NAMES[@]}"; do
    if [[ -n "${!env_name+x}" ]]; then
        export "SINGULARITYENV_${env_name}=${!env_name}"
    fi
done

if [[ -n "${ABSCONDA_ENV_PASSTHROUGH:-}" ]]; then
    IFS=',' read -r -a runtime_env_names <<< "$ABSCONDA_ENV_PASSTHROUGH"
    for env_name in "${runtime_env_names[@]}"; do
        if [[ -n "$env_name" && -n "${!env_name+x}" ]]; then
            export "SINGULARITYENV_${env_name}=${!env_name}"
        fi
    done
fi

if [[ -n "${ABSCONDA_ENV_SET:-}" ]]; then
    IFS=',' read -r -a runtime_env_pairs <<< "$ABSCONDA_ENV_SET"
    for env_assignment in "${runtime_env_pairs[@]}"; do
        if [[ -n "$env_assignment" && "$env_assignment" == *=* ]]; then
            env_name="${env_assignment%%=*}"
            env_value="${env_assignment#*=}"
            export "SINGULARITYENV_${env_name}=${env_value}"
        fi
    done
fi

{% if gpu %}
# GPU support
GPU_FLAG="--nv"
{% else %}
GPU_FLAG=""
{% endif %}

{% if env_dir %}
# Set PATH to include conda environment
{% set path_parts = [env_dir ~ "/bin", "/opt/conda/bin"] %}
{% if use_pbs_env %}
{% set _ = path_parts.append("${PBS_PATH}") %}
{% endif %}
{% for d in shim_path_dirs %}
{% set _ = path_parts.append(d) %}
{% endfor %}
{% set _ = path_parts.extend(["/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"]) %}
export SINGULARITYENV_PATH="{{ path_parts | join(':') }}"
export SINGULARITYENV_CONDA_PREFIX="{{ env_dir }}"
{% else %}
{% set path_parts = ["/opt/conda/bin"] %}
{% if use_pbs_env %}
{% set _ = path_parts.append("${PBS_PATH}") %}
{% endif %}
{% for d in shim_path_dirs %}
{% set _ = path_parts.append(d) %}
{% endfor %}
{% set _ = path_parts.extend(["/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"]) %}
export SINGULARITYENV_PATH="{{ path_parts | join(':') }}"
{% endif %}

# Execute command in container
exec singularity exec \
    $NO_HOME \
    $GPU_FLAG \
    "${MOUNTS[@]}" \
    "$SIF_FILE" \
    {{ command }} "$@"
